{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/46slv/CharacterKernel/schemas/surface_attachment.schema.json",
  "title": "CharacterKernel SurfaceAttachment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attachment_id", "kind", "target_surface_id", "target_topology_revision", "coordinate"],
  "properties": {
    "schema_version": {"const": 1},
    "attachment_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["HAIR_ROOT", "GARMENT_FIT", "SOCKET", "LANDMARK", "JOINT_SUPPORT"]},
    "target_surface_id": {"type": "string", "minLength": 1},
    "target_topology_revision": {"type": "string", "minLength": 1},
    "target_semantic_revision": {"type": ["string", "null"]},
    "space": {"type": "string", "enum": ["OBJECT", "TARGET_LOCAL"], "default": "TARGET_LOCAL"},
    "unit_scale_meters": {"type": "number", "exclusiveMinimum": 0},
    "coordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "triangle_id", "weights"],
          "properties": {
            "type": {"const": "BARYCENTRIC_TRIANGLE"},
            "triangle_id": {"type": "integer", "minimum": 0},
            "weights": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "vertex_ids", "weights"],
          "properties": {
            "type": {"const": "VERTEX_SET"},
            "vertex_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
            "weights": {"type": "array", "minItems": 1, "items": {"type": "number"}}
          }
        }
      ]
    },
    "normal_offset": {"type": "number", "default": 0},
    "orientation_hint": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
